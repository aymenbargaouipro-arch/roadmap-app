# Copie ce fichier en ".env" et remplace chaque valeur. Ne commite jamais le fichier .env.

# Base de donnees (docker-compose.yml de developpement)
DATABASE_URL="postgresql://roadmap:roadmap@localhost:5432/roadmap_db?schema=public"

# Secret de signature des sessions : 32 caracteres aleatoires minimum.
# L'application refuse de demarrer avec la valeur d'exemple ci-dessous.
# Pour en generer un dans PowerShell :
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
NEXTAUTH_SECRET="change-me-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cle de chiffrement des tokens Jira : 32 caracteres aleatoires minimum.
JIRA_ENCRYPTION_KEY="change-me-with-another-random-string"
# Uniquement pendant un changement de cle : l'ancienne valeur de JIRA_ENCRYPTION_KEY.
# JIRA_ENCRYPTION_KEY_PREVIOUS=""

# Proxy d'entreprise pour les appels sortants (Jira et Anthropic). A commenter hors reseau CRIT.
# JIRA_HTTP_PROXY="http://10.31.254.246:80"
# Sur le reseau CRIT, le proxy inspecte le trafic HTTPS : Node doit faire confiance au certificat
# racine de CRIT installe dans Windows. Cela se regle avec NODE_USE_SYSTEM_CA=1, a definir comme
# variable d'environnement Windows et PAS dans ce fichier (Node la lit a son demarrage, avant
# que Next ne charge .env). Ne jamais utiliser NODE_TLS_REJECT_UNAUTHORIZED=0, qui desactive
# toute verification des certificats.

# Cle API Anthropic (imports Excel et image par IA).
ANTHROPIC_API_KEY="sk-ant-..."

# Facultatif : plafond global d'analyses d'import par IA, pour toute l'instance et par jour
# (defaut : 30). Protege le budget Anthropic, en plus des limites par compte et par espace.
# APEX_AI_DAILY_LIMIT="30"

# Facultatif : mot de passe fixe (12 caracteres minimum) pour les comptes de demo crees par
# "npm run db:seed". Sans cette variable, un mot de passe aleatoire est genere a chaque seed.
# SEED_DEMO_PASSWORD=""
