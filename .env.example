# Copy this file to ".env" and replace every value. Never commit the .env file.
# Copie ce fichier en ".env" et remplace chaque valeur. Ne commite jamais le fichier .env.

# PostgreSQL database (docker-compose.yml for development)
DATABASE_URL="postgresql://roadmap:roadmap@localhost:5432/roadmap_db?schema=public"

# Session signing secret: 32 random characters minimum.
# The application refuses to start with the example value below.
# To generate one:
#   PowerShell: $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   macOS / Linux: openssl rand -base64 48
NEXTAUTH_SECRET="change-me-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Encryption key for Jira API tokens: 32 random characters minimum.
JIRA_ENCRYPTION_KEY="change-me-with-another-random-string"
# Only during a key rotation: the previous value of JIRA_ENCRYPTION_KEY.
# JIRA_ENCRYPTION_KEY_PREVIOUS=""

# Optional: corporate proxy for outgoing calls (Jira and Anthropic).
# Comment it out when you are not behind the proxy.
# JIRA_HTTP_PROXY="http://proxy.example.com:8080"
# If the proxy inspects HTTPS traffic, let Node trust the system certificates with
# NODE_USE_SYSTEM_CA=1, set as a SYSTEM environment variable and NOT in this file (Node reads
# it at startup, before Next loads .env). Never use NODE_TLS_REJECT_UNAUTHORIZED=0, which
# disables all certificate verification.

# Anthropic API key (AI-assisted Excel and image imports).
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: AI analyses per day for the whole instance (default: 30). Protects the Anthropic
# budget, on top of the per-user and per-workspace limits.
# APEX_AI_DAILY_LIMIT="30"

# Optional: fixed password (12 characters minimum) for the demo accounts created by
# "npm run db:seed". Without it, a random password is generated at each seed.
# SEED_DEMO_PASSWORD=""
